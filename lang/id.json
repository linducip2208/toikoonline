    "pseo.buy_who": "Siapa yang Cocok Pakai?",
    "pseo.buy_who_sub": "Source code ini cocok untuk berbagai skenario bisnis",
    "pseo.buy_who1_t": "Pemilik Bisnis",
    "pseo.buy_who1_d": "Punya toko fisik dan ingin go online? Source code ini jadi fondasi toko online Anda dalam hitungan hari.",
    "pseo.buy_who2_t": "Developer / Agency",
    "pseo.buy_who2_d": "Jual ke klien dengan brand sendiri. Whitelabel = markup harga sesuka hati. Tidak perlu develop dari nol.",
    "pseo.buy_who3_t": "Startup / Founder",
    "pseo.buy_who3_d": "MVP siap launch dalam 1 minggu. Validasi ide marketplace tanpa burn cash development mahal.",
    "pseo.buy_cta_badge": "Dapatkan Sekarang",
    "pseo.buy_cta_title": "Siap Punya Toko Online Sendiri?",
    "pseo.buy_cta_sub": "Hubungi kami via WhatsApp untuk info harga, demo, dan dokumentasi lengkap.",
    "pseo.chat_wa_now": "Chat WhatsApp Sekarang",
